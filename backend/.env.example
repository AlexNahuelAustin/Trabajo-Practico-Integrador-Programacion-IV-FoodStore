# Copiar este archivo como .env y completar los valores.
# La base de datos debe existir antes de ejecutar el seed.
DATABASE_URL=postgresql+psycopg2://postgres:tu_contraseña@localhost:5432/foodstore_db

# Clave para firmar el JWT: mínimo 32 caracteres.
# Generar una con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambiar-esta-clave-de-al-menos-32-caracteres

ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
FRONTEND_ORIGIN=http://localhost:5173